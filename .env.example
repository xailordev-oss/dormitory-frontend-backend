# =========================================================
# ສຳເນົາໄຟລ໌ນີ້ເປັນ .env ແລ້ວແກ້ຄ່າ (PowerShell: Copy-Item .env.example .env)
# ⚠️ ຫ້າມອັບໂຫຼດ .env ຂຶ້ນ GitHub — ມີລະຫັດລັບ
# =========================================================

# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== JWT (ຕ້ອງຕັ້ງ 2 ຄ່ານີ້ ແລະຕ້ອງຕ່າງກັນ) =====
# ສ້າງຄ່າສຸ່ມ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ປ່ຽນເປັນຄ່າສຸ່ມທີ່ຍາວ
JWT_REFRESH_SECRET=ປ່ຽນເປັນຄ່າສຸ່ມອີກອັນໜຶ່ງ
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dormitory_db

# ===== CORS =====
# ຕ້ອງໃສ່ສະເພາະເມື່ອ frontend ຢູ່ຄົນລະ domain/port ກັບ server (ໜ້າເວັບທີ່ມາກັບໂປຣເຈັກບໍ່ຕ້ອງໃຊ້)
# ຫຼາຍອັນຂັ້ນດ້ວຍ ,
CORS_ORIGIN=

# ===== ຄວາມປອດໄພ =====
# ຈຳນວນ proxy ທີ່ຢູ່ໜ້າ server (ຢູ່ຫຼັງ nginx = 1, ແລ່ນກົງໆ = 0)
TRUST_PROXY=0
# ຈຳກັດຈຳນວນ request (ແນະນຳໃຫ້ເປີດ). ເມື່ອລອງເດົາລະຫັດຜິດເກີນ AUTH_RATE_LIMIT_MAX ເທື່ອ/15 ນາທີ ຈະຖືກບລັອກ
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=600
# false = ປິດການສະໝັກບັນຊີເອງ (admin ສ້າງບັນຊີໃຫ້ຜ່ານໜ້າ "ຜູ້ໃຊ້")
ALLOW_REGISTRATION=true

# ===== ໜ້າເວັບ =====
# server ເປີດໜ້າເວັບ (ໂຟນເດີ public/) ໃຫ້ທີ່ http://localhost:PORT
SERVE_FRONTEND=true
# URL ທີ່ຜູ້ໃຊ້ເຂົ້າເວັບ (ໃຊ້ສ້າງລິ້ງ "ຕັ້ງລະຫັດໃໝ່" ໃນອີເມວ)
APP_URL=http://localhost:3000
RESET_TOKEN_MINUTES=30

# ===== ອີເມວ (ບໍ່ບັງຄັບ) =====
# ຖ້າບໍ່ຕັ້ງ SMTP_HOST → ລະບົບບໍ່ສົ່ງອີເມວ ແຕ່ທຸກຢ່າງອື່ນໃຊ້ໄດ້ປົກກະຕິ
# (ລືມລະຫັດຜ່ານ: admin ຕັ້ງລະຫັດໃຫ້ຜ່ານໜ້າ "ຜູ້ໃຊ້" ໄດ້)
# ຕົວຢ່າງ Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ຫໍພັກ <no-reply@example.com>"
